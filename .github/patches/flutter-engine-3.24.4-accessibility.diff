+  root.children_in_traversal_order = &child_id;
+  root.children_in_hit_test_order = &child_id;
+  root.rect = {0, 0, 100, 100};
+  root.transform = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+  FlutterSemanticsNode2 leaf{sizeof(FlutterSemanticsNode2), 1};
+  leaf.rect = root.rect;
+  leaf.transform = root.transform;
