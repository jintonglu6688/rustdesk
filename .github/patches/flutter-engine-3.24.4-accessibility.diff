+TEST(AccessibilityBridgeWindows, HitTestSkipsIgnoredLeaf) {
+  auto engine = GetTestEngine();
+  FlutterWindowsViewSpy view{
+      engine.get(), std::make_unique<NiceMock<MockWindowBindingHandler>>()};
+  EngineModifier modifier{engine.get()};
+  modifier.SetImplicitView(&view);
+  view.OnUpdateSemanticsEnabled(true);
+  auto bridge = view.accessibility_bridge().lock();
+  FlutterSemanticsNode2 root{sizeof(FlutterSemanticsNode2), 0};
+  const int32_t child_id = 1;
+  root.child_count = 1;
+  root.children_in_traversal_order = &child_id;
+  root.children_in_hit_test_order = &child_id;
+  root.rect = {0, 0, 100, 100};
+  root.transform = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+  FlutterSemanticsNode2 leaf{sizeof(FlutterSemanticsNode2), 1};
+  leaf.rect = root.rect;
+  leaf.transform = root.transform;
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(leaf);
+  bridge->CommitUpdates();
+  auto root_delegate = bridge->GetFlutterPlatformNodeDelegateFromID(0).lock();
+  EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(1)
+                  .lock()
+                  ->GetAXNode()
+                  ->IsIgnored());
+  EXPECT_EQ(root_delegate->HitTestSync(10, 10),
+            root_delegate->GetNativeViewAccessible());
+}
