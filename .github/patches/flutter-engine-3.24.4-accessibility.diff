+TEST(AccessibilityBridgeWindows, TabControlExposesNativeSelection) {
+  auto engine = GetTestEngine();
+  FlutterWindowsViewSpy view{
+      engine.get(), std::make_unique<NiceMock<MockWindowBindingHandler>>()};
+  EngineModifier modifier{engine.get()};
+  modifier.SetImplicitView(&view);
+  view.OnUpdateSemanticsEnabled(true);
+  auto bridge = view.accessibility_bridge().lock();
+  FlutterSemanticsNode2 root{sizeof(FlutterSemanticsNode2), 0};
+  const int32_t scroll_id = 3;
+  root.child_count = 1;
+  root.children_in_traversal_order = &scroll_id;
+  root.children_in_hit_test_order = &scroll_id;
+  root.flags = kFlutterSemanticsFlagIsTabBar;
+  FlutterSemanticsNode2 scroll{sizeof(FlutterSemanticsNode2), 3};
+  const int32_t children[] = {1, 2};
+  scroll.child_count = 2;
+  scroll.children_in_traversal_order = children;
+  scroll.children_in_hit_test_order = children;
+  scroll.flags = kFlutterSemanticsFlagHasImplicitScrolling;
+  scroll.scroll_child_count = 2;
+  FlutterSemanticsNode2 first{sizeof(FlutterSemanticsNode2), 1};
+  first.label = "Home";
+  first.flags = static_cast<FlutterSemanticsFlag>(
+      kFlutterSemanticsFlagIsTab | kFlutterSemanticsFlagHasSelectedState |
+      kFlutterSemanticsFlagIsSelected);
+  first.actions = kFlutterSemanticsActionTap;
+  FlutterSemanticsNode2 second = first;
+  second.id = 2;
+  second.label = "Settings";
+  second.flags = static_cast<FlutterSemanticsFlag>(
+      kFlutterSemanticsFlagIsTab | kFlutterSemanticsFlagHasSelectedState);
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(first);
+  bridge->AddFlutterSemanticsNodeUpdate(second);
+  bridge->AddFlutterSemanticsNodeUpdate(scroll);
+  bridge->CommitUpdates();
+
+  Microsoft::WRL::ComPtr<IRawElementProviderSimple> container, item;
+  ASSERT_EQ(bridge->GetFlutterPlatformNodeDelegateFromID(0).lock()
+                ->GetNativeViewAccessible()->QueryInterface(IID_PPV_ARGS(&container)), S_OK);
+  ASSERT_EQ(bridge->GetFlutterPlatformNodeDelegateFromID(2).lock()
+                ->GetNativeViewAccessible()->QueryInterface(IID_PPV_ARGS(&item)), S_OK);
+  VARIANT value{};
+  ASSERT_EQ(container->GetPropertyValue(UIA_ControlTypePropertyId, &value), S_OK);
+  EXPECT_EQ(value.lVal, UIA_TabControlTypeId);
+  ASSERT_EQ(item->GetPropertyValue(UIA_ControlTypePropertyId, &value), S_OK);
+  EXPECT_EQ(value.lVal, UIA_TabItemControlTypeId);
+  VARIANT self{}, role{};
+  self.vt = VT_I4;
+  self.lVal = CHILDID_SELF;
+  ASSERT_EQ(bridge->GetFlutterPlatformNodeDelegateFromID(2).lock()
+                ->GetNativeViewAccessible()->get_accRole(self, &role), S_OK);
+  EXPECT_EQ(role.lVal, ROLE_SYSTEM_PAGETAB);
+
+  Microsoft::WRL::ComPtr<IUnknown> pattern;
+  Microsoft::WRL::ComPtr<ISelectionProvider> selection;
+  ASSERT_EQ(container->GetPatternProvider(UIA_SelectionPatternId, &pattern), S_OK);
+  ASSERT_NE(pattern.Get(), nullptr);
+  ASSERT_EQ(pattern.As(&selection), S_OK);
+  BOOL state = FALSE;
+  ASSERT_EQ(selection->get_IsSelectionRequired(&state), S_OK);
+  EXPECT_TRUE(state);
+  ASSERT_EQ(selection->get_CanSelectMultiple(&state), S_OK);
+  EXPECT_FALSE(state);
+  pattern.Reset();
+  ASSERT_EQ(item->GetPatternProvider(UIA_InvokePatternId, &pattern), S_OK);
+  EXPECT_EQ(pattern.Get(), nullptr);
+  Microsoft::WRL::ComPtr<ISelectionItemProvider> selection_item;
+  ASSERT_EQ(item->GetPatternProvider(UIA_SelectionItemPatternId, &pattern), S_OK);
+  ASSERT_NE(pattern.Get(), nullptr);
+  ASSERT_EQ(pattern.As(&selection_item), S_OK);
+  ASSERT_EQ(selection_item->get_IsSelected(&state), S_OK);
+  EXPECT_FALSE(state);
+  Microsoft::WRL::ComPtr<IRawElementProviderSimple> owner;
+  ASSERT_EQ(selection_item->get_SelectionContainer(&owner), S_OK);
+  EXPECT_EQ(owner.Get(), container.Get());
+
+  uint64_t dispatched_id = 0;
+  modifier.embedder_api().DispatchSemanticsAction = MOCK_ENGINE_PROC(
+      DispatchSemanticsAction,
+      ([&dispatched_id](FLUTTER_API_SYMBOL(FlutterEngine) engine, uint64_t id,
+                       FlutterSemanticsAction action, const uint8_t* data,
+                       size_t data_length) {
+        EXPECT_EQ(action, kFlutterSemanticsActionTap);
+        dispatched_id = id;
+        return kSuccess;
+      }));
+  ASSERT_EQ(selection_item->Select(), S_OK);
+  EXPECT_EQ(dispatched_id, 2u);
+  auto spy = std::static_pointer_cast<AccessibilityBridgeWindowsSpy>(bridge);
+  spy->ResetRecords();
+  first.flags = second.flags;
+  second.flags = static_cast<FlutterSemanticsFlag>(
+      second.flags | kFlutterSemanticsFlagIsSelected);
+  bridge->AddFlutterSemanticsNodeUpdate(first);
+  bridge->AddFlutterSemanticsNodeUpdate(second);
+  bridge->CommitUpdates();
+  ASSERT_EQ(selection_item->get_IsSelected(&state), S_OK);
+  EXPECT_TRUE(state);
+  bool selected_event = false, removed_event = false;
+  for (const auto& event : spy->dispatched_events()) {
+    selected_event |= event.node_delegate->GetAXNode()->id() == 2 &&
+                      event.event_type == ax::mojom::Event::kSelection;
+    removed_event |= event.node_delegate->GetAXNode()->id() == 1 &&
+                     event.event_type == ax::mojom::Event::kSelectionRemove;
+  }
+  EXPECT_TRUE(selected_event);
+  EXPECT_TRUE(removed_event);
+  SAFEARRAY* selected_items = nullptr;
+  ASSERT_EQ(selection->GetSelection(&selected_items), S_OK);
+  ASSERT_NE(selected_items, nullptr);
+  LONG first_index = 0, last_index = -1;
+  ASSERT_EQ(SafeArrayGetUBound(selected_items, 1, &last_index), S_OK);
+  EXPECT_EQ(last_index, 0);
+  Microsoft::WRL::ComPtr<IUnknown> selected_item;
+  ASSERT_EQ(SafeArrayGetElement(selected_items, &first_index, selected_item.GetAddressOf()), S_OK);
+  Microsoft::WRL::ComPtr<IRawElementProviderSimple> selected_provider;
+  ASSERT_EQ(selected_item.As(&selected_provider), S_OK);
+  EXPECT_EQ(selected_provider.Get(), item.Get());
+  SafeArrayDestroy(selected_items);
+  for (bool vertical : {false, true}) {
+    root.flags = static_cast<FlutterSemanticsFlag>(
+        kFlutterSemanticsFlagIsTabBar |
+        (vertical ? kFlutterSemanticsFlagIsVerticalTabBar : 0));
+    bridge->AddFlutterSemanticsNodeUpdate(root);
+    bridge->CommitUpdates();
+    ASSERT_EQ(container->GetPropertyValue(UIA_OrientationPropertyId, &value), S_OK);
+    EXPECT_EQ(value.lVal, vertical ? OrientationType_Vertical : OrientationType_Horizontal);
+  }
+}
