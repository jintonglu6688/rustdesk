+TEST(AccessibilityBridgeWindows, MsaaSelectionStateRequiresDeclaration) {
+  auto engine = GetTestEngine();
+  FlutterWindowsViewSpy view{
+      engine.get(), std::make_unique<NiceMock<MockWindowBindingHandler>>()};
+  EngineModifier modifier{engine.get()};
+  modifier.SetImplicitView(&view);
+  view.OnUpdateSemanticsEnabled(true);
+  auto bridge = view.accessibility_bridge().lock();
+  FlutterSemanticsNode2 node{sizeof(FlutterSemanticsNode2), 0};
+  node.label = "control";
+  node.rect = {0, 0, 100, 100};
+  node.transform = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+  const int states[] = {
+      kFlutterSemanticsFlagIsButton,
+      kFlutterSemanticsFlagIsTextField,
+      kFlutterSemanticsFlagIsButton | kFlutterSemanticsFlagHasSelectedState,
+      kFlutterSemanticsFlagIsButton | kFlutterSemanticsFlagHasSelectedState |
+          kFlutterSemanticsFlagIsSelected,
+      kFlutterSemanticsFlagIsButton,
+      0};
+  for (int flags : states) {
+    node.label = flags == 0 ? "" : "control";
+    node.tooltip = flags == 0 ? "Settings" : "";
+    node.actions = static_cast<FlutterSemanticsAction>(
+        flags == 0 ? kFlutterSemanticsActionTap : 0);
+    node.flags = static_cast<FlutterSemanticsFlag>(flags);
+    bridge->AddFlutterSemanticsNodeUpdate(node);
+    bridge->CommitUpdates();
+    auto native = bridge->GetFlutterPlatformNodeDelegateFromID(0)
+                      .lock()
+                      ->GetNativeViewAccessible();
+    VARIANT self{}, state{};
+    self.vt = VT_I4;
+    self.lVal = CHILDID_SELF;
+    ASSERT_EQ(native->get_accState(self, &state), S_OK);
+    ASSERT_EQ(state.vt, VT_I4);
+    EXPECT_EQ((state.lVal & STATE_SYSTEM_SELECTABLE) != 0,
+              (flags & kFlutterSemanticsFlagHasSelectedState) != 0);
+    EXPECT_EQ((state.lVal & STATE_SYSTEM_SELECTED) != 0,
+              (flags & kFlutterSemanticsFlagIsSelected) != 0);
+    EXPECT_EQ(state.lVal & STATE_SYSTEM_INVISIBLE, 0);
+    EXPECT_EQ(state.lVal & STATE_SYSTEM_OFFSCREEN, 0);
+    if (flags == 0) {
+      BSTR name = nullptr;
+      ASSERT_EQ(native->get_accName(self, &name), S_OK);
+      EXPECT_STREQ(name, L"Settings");
+      SysFreeString(name);
+    }
+  }
+}
