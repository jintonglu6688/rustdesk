@@ -6,6 +6,8 @@
 
 #include <functional>
 #include <utility>
+
+#include "flutter/fml/build_config.h"
 
 #include "flutter/third_party/accessibility/ax/ax_tree_manager_map.h"
 #include "flutter/third_party/accessibility/ax/ax_tree_update.h"
@@ -543,6 +545,22 @@
 void AccessibilityBridge::SetNameFromFlutterUpdate(ui::AXNodeData& node_data,
                                                    const SemanticsNode& node) {
   node_data.SetName(node.label);
+#if defined(FML_OS_WIN)
+  // Flutter 3.24 has no access-key field. Controls use an exact Alt+letter hint;
+  // keep ordinary hints and non-interactive labels on the existing path.
+  if ((node_data.role == ax::mojom::Role::kButton ||
+       node_data.role == ax::mojom::Role::kCheckBox ||
+       node_data.role == ax::mojom::Role::kTextField ||
+       node_data.role == ax::mojom::Role::kTab) &&
+      node.hint.size() == 5 && node.hint.compare(0, 4, "Alt+") == 0 &&
+      node.hint[4] >= 'A' && node.hint[4] <= 'Z') {
+    node_data.AddStringAttribute(ax::mojom::StringAttribute::kAccessKey,
+                                node.hint);
+    // Chromium's MSAA provider reads kKeyShortcuts for accKeyboardShortcut.
+    node_data.AddStringAttribute(ax::mojom::StringAttribute::kKeyShortcuts,
+                                node.hint);
+  }
+#endif
 }
 
