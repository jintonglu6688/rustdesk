+
+TEST(AccessibilityBridgeWindows, CmAccessKeysReachUiaAndMsaa) {
+  auto engine = GetTestEngine();
+  FlutterWindowsViewSpy view{
+      engine.get(), std::make_unique<NiceMock<MockWindowBindingHandler>>()};
+  EngineModifier modifier{engine.get()};
+  modifier.SetImplicitView(&view);
+  view.OnUpdateSemanticsEnabled(true);
+  auto bridge = view.accessibility_bridge().lock();
+  FlutterSemanticsNode2 node{sizeof(FlutterSemanticsNode2), 0};
+  node.label = "Accept";
+  node.rect = {0, 0, 100, 100};
+  node.transform = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+  struct Case { int flags; const char* hint; const wchar_t* expected; };
+  const Case cases[] = {
+      {kFlutterSemanticsFlagIsButton, "Alt+A", L"Alt+A"},
+      {kFlutterSemanticsFlagHasCheckedState | kFlutterSemanticsFlagIsChecked,
+       "Alt+K", L"Alt+K"},
+      {kFlutterSemanticsFlagIsTextField, "Alt+I", L"Alt+I"},
+      {kFlutterSemanticsFlagIsTab | kFlutterSemanticsFlagHasSelectedState,
+       "Alt+N", L"Alt+N"},
+      {kFlutterSemanticsFlagIsButton, "", nullptr},
+      {kFlutterSemanticsFlagIsButton, "Alt+A extra", nullptr},
+      {0, "Alt+A", nullptr}};
+  for (const auto& item : cases) {
+    node.flags = static_cast<FlutterSemanticsFlag>(item.flags);
+    node.hint = item.hint;
+    bridge->AddFlutterSemanticsNodeUpdate(node);
+    bridge->CommitUpdates();
+    auto native = bridge->GetFlutterPlatformNodeDelegateFromID(0)
+                      .lock()->GetNativeViewAccessible();
+    Microsoft::WRL::ComPtr<IRawElementProviderSimple> provider;
+    ASSERT_EQ(native->QueryInterface(IID_PPV_ARGS(&provider)), S_OK);
+    VARIANT access_key{};
+    ASSERT_EQ(provider->GetPropertyValue(UIA_AccessKeyPropertyId, &access_key), S_OK);
+    VARIANT self{};
+    self.vt = VT_I4;
+    self.lVal = CHILDID_SELF;
+    BSTR shortcut = nullptr;
+    const auto result = native->get_accKeyboardShortcut(self, &shortcut);
+    if (item.expected) {
+      ASSERT_EQ(access_key.vt, VT_BSTR);
+      EXPECT_STREQ(access_key.bstrVal, item.expected);
+      ASSERT_EQ(result, S_OK);
+      EXPECT_STREQ(shortcut, item.expected);
+      BSTR name = nullptr;
+      ASSERT_EQ(native->get_accName(self, &name), S_OK);
+      EXPECT_STREQ(name, L"Accept");
+      SysFreeString(name);
+    } else {
+      EXPECT_EQ(access_key.vt, VT_EMPTY);
+      EXPECT_EQ(result, S_FALSE);
+    }
+    SysFreeString(shortcut);
+    VariantClear(&access_key);
+  }
 }
 
